#include "libftprintf.h"

int	ft_printf(const char *format, ...)
{
	size_t	i;
	size_t	b_count;
	va_list	args;

	i = 0;
	b_count = 0;
	va_start(args, format);
	while (format[i])
	{
		if (format[i] == '%')
		{
			b_count += handle_conversion(format[i + 1], &args);
			i++;
		}
		else
		{
			ft_putchar_fd(format[i], 1);
			b_count++;
		}
		i++;
	}
	va_end(args);
	return (b_count);
}
